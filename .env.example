# ==============================================================================
# MUHASABAH APP — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your values
# ==============================================================================

# Client-Side Supabase Configuration (Vite)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# Optional Server / Backend Edge Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"

# Gemini AI (Optional, for spiritual reflection insights)
GEMINI_API_KEY=""

# Application Host URL (Optional, for production redirects)
APP_URL="http://localhost:3000"
